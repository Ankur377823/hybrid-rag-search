# ==============================================================================
# HybridRAG Studio — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# OpenAI / LLM Configuration
# ------------------------------------------------------------------------------
RAG_OPENAI_API_KEY=sk-...
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_GENERATION_MODEL=gpt-4o
RAG_JUDGE_MODEL=gpt-4o-mini
RAG_RERANK_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Chunking Strategy Configuration
# Options: 'recursive' (default), 'fixed', 'semantic'
# ------------------------------------------------------------------------------
RAG_CHUNKING_STRATEGY=recursive
RAG_CHUNK_SIZE_TOKENS=512
RAG_CHUNK_OVERLAP_TOKENS=64
RAG_SEMANTIC_CHUNK_MIN_TOKENS=200
RAG_SEMANTIC_CHUNK_MAX_TOKENS=900

# ------------------------------------------------------------------------------
# Ingestion Deduplication & Retrieval Parameters
# ------------------------------------------------------------------------------
RAG_DEDUP_COSINE_THRESHOLD=0.95
RAG_DENSE_TOP_K=20
RAG_SPARSE_TOP_K=20
RAG_RRF_K=60
RAG_FINAL_TOP_K=5
RAG_RERANK_KIND=llm

# ------------------------------------------------------------------------------
# Evaluation & Safety Gate Parameters
# ------------------------------------------------------------------------------
# Retrieval confidence score below this threshold triggers immediate "I don't know."
RAG_IDK_RETRIEVAL_THRESHOLD=0.35
# Weighted blend: composite = w·citation_accuracy + (1-w)·retrieval_confidence
RAG_JUDGE_WEIGHT=0.5

# ------------------------------------------------------------------------------
# Storage & Paths
# ------------------------------------------------------------------------------
RAG_INDEX_DIR=./.rag-index
RAG_EVAL_SET_PATH=./eval/golden_qa.jsonl
RAG_UPLOAD_DIR=./data/uploads

# ------------------------------------------------------------------------------
# PostgreSQL / Neon Database Configuration
# Paste your Neon connection string here:
# e.g. postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# If left empty, the engine automatically falls back to local SQLite (./data/rag.db)
# ------------------------------------------------------------------------------
RAG_DATABASE_URL=

# ------------------------------------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------------------------------------
RAG_JWT_SECRET=super-secret-rag-jwt-token-key-change-me
RAG_JWT_ALGORITHM=HS256
RAG_JWT_EXPIRE_MINUTES=1440
RAG_ADMIN_EMAIL=admin@hybridrag.io
RAG_ADMIN_PASSWORD=change-to-a-strong-password

# ------------------------------------------------------------------------------
# Optional Vector Storage (Qdrant)
# ------------------------------------------------------------------------------
RAG_QDRANT_URL=
RAG_QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# API Server Configuration
# ------------------------------------------------------------------------------
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8100
RAG_LOG_LEVEL=INFO
RAG_REQUEST_TIMEOUT_S=60.0
RAG_MAX_RETRIES=2
